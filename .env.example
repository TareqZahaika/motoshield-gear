# MotoShield Gear backend environment variables
# Copy this file to .env for local testing. Do not commit real secrets.

NODE_ENV=development

# AI assistant provider settings. Leave blank for demo responses.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_AGENT_SYSTEM_PROMPT=You are MotoShield Gear assistant. Help riders choose safe motorcycle gear.

# Telegram bot settings. Keep these only on the backend/Railway variables.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PUBLIC_LINK=https://t.me/

# Optional Supabase server-side settings, if you later move writes to backend.
SUPABASE_URL=https://mshgtmpnesceletxvpts.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
